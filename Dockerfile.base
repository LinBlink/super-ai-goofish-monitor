# syntax=docker/dockerfile:1.7

FROM python:3.11-slim-bookworm

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    RUNNING_IN_DOCKER=true \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    SERVER_PORT=8000 \
    TZ=Asia/Shanghai

ARG APP_UID=1000
ARG APP_GID=1000

COPY requirements-runtime.txt /tmp/requirements-runtime.txt

RUN python3 -m venv "$VIRTUAL_ENV"

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -i https://pypi.tuna.tsinghua.edu.cn/simple -r /tmp/requirements-runtime.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tzdata \
        tini \
        libzbar0 \
    && playwright install --with-deps --no-shell chromium \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements-runtime.txt

RUN groupadd --gid "$APP_GID" appuser \
    && useradd --uid "$APP_UID" --gid appuser --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data /app/state /app/logs /app/images /app/jsonl /app/price_history \
    && chown -R appuser:appuser /app "$VIRTUAL_ENV" "$PLAYWRIGHT_BROWSERS_PATH"

ENTRYPOINT ["tini", "--"]
