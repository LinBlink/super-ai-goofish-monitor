################################################################################
# 🚀 1. 必填核心配置 (AI 模型)
# 只有配置了 AI，本项目才能实现智能分析。建议优先完成此处配置。
################################################################################

# 模型的 API Key。
OPENAI_API_KEY=sk-...

# 模型的 API 接口地址。
# 这里需要填写服务商提供的、兼容 OpenAI 格式的 API 地址。
# 例如: https://api.openai.com/v1/ 或国内大模型厂商提供的地址。
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/

# 使用的模型名称。
# 注意：该模型必须支持图片分析功能 (Vision)。
OPENAI_MODEL_NAME=XiaomiMiMo/MiMo-V2-Flash


################################################################################
# 🖥️ 2. Web 管理界面配置
# 用于访问控制台，保护你的配置不被他人篡改。
################################################################################

# 服务运行端口 (默认 8000)
SERVER_PORT=8000

# 管理员账号与密码 (默认 admin / admin123)
WEB_USERNAME=admin
WEB_PASSWORD=admin123


################################################################################
# 🕷️ 3. 爬虫基础设置
# 控制浏览器的运行行为。
################################################################################

# 爬虫是否以无头模式运行 (默认 true)。
# 注意：使用 Docker 部署时必须设为 true。
RUN_HEADLESS=true

# 是否使用 Edge 浏览器内核 (默认 false, 即使用 Chrome)。
# 仅影响本地浏览器通道；Docker 镜像未内置 Edge，容器内会固定使用 Chromium。
LOGIN_IS_EDGE=false

# 是否使用系统已安装的 Chrome 浏览器 (默认 true)。
# true: 使用系统 Chrome (channel="chrome")；false: 使用 Playwright 自带的 Chromium 环境。
USE_SYSTEM_CHROME=true

# 是否开启自动转换：将电脑端链接转换为手机端链接 (建议开启)
PCURL_TO_MOBILE=true


################################################################################
# 🛠️ 4. AI 策略与兼容性 (可选)
# 如果你发现 AI 分析不准确或报错，请尝试调整此处。
################################################################################

# 单任务内 AI 分析并发数 (默认 1，即串行执行)。
# 设为大于 1 的值可同时分析多个商品，但可能增加 API 限流风险。
AI_ANALYSIS_CONCURRENCY=1

# AI 调用超时时间 (默认 300 秒，即 5 分钟)。
# 单次 AI 请求超过该时间未返回结果将视作超时失败，进入重试/兜底流程。
AI_CALL_TIMEOUT_SECONDS=300

# AI 调试模式 (默认 false)。开启后控制台会打印详细的 AI 分析日志。
AI_DEBUG_MODE=false

# (可选) 为 AI 请求配置 HTTP/S 代理。支持 http 和 socks5。
# 例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=""

# 是否启用 enable_thinking 参数 (某些模型如 DeepSeek 可能需要，默认 false)
ENABLE_THINKING=false

# 是否启用 response_format (默认 true)。
# 豆包模型等不支持 json_object 格式的需设为 false；Gemini/GPT 等建议设为 true。
ENABLE_RESPONSE_FORMAT=true


################################################################################
# 📢 5. 消息推送配置 (可选)
# 只要配置其中一个即可收到通知。
# 每个渠道都有独立的开关（如 NTFY_ENABLED、BARK_ENABLED、EMAIL_ENABLED 等），默认 true；
# 也可以在 Web UI 的“系统设置 -> 通知设置”页面直接勾选/取消，无需手动编辑本文件。
################################################################################

# --- ntfy (推荐) ---
NTFY_TOPIC_URL=

# --- Bark (iOS 推荐) ---
# 例如: https://api.day.app/your_key
BARK_URL=

# --- 企业微信机器人 ---
WX_BOT_URL=

# --- Telegram 机器人 ---
# 获取 Token 找 @BotFather，获取 Chat ID 找 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可选：Telegram Bot API 反代地址，默认 https://api.telegram.org
TELEGRAM_API_BASE_URL=

# --- Gotify ---
GOTIFY_URL=
GOTIFY_TOKEN=

# --- 通用 Webhook ---
WEBHOOK_URL=
WEBHOOK_METHOD="POST"
WEBHOOK_CONTENT_TYPE="JSON"
WEBHOOK_HEADERS='{"X-API-TOKEN":"your-secret-token"}'
WEBHOOK_QUERY_PARAMETERS='{"title":"{{title}}","content":"{{content}}"}'
WEBHOOK_BODY='{"title":"{{title}}","content":"{{content}}"}'

# --- 邮件 (SMTP) ---
# SMTP_HOST、SMTP_USERNAME、SMTP_PASSWORD、SMTP_TO_ADDRESS 必须同时配置才会启用。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 可选：发件地址，留空则使用 SMTP_USERNAME
SMTP_FROM_ADDRESS=
# 收件地址，多个用英文逗号分隔
SMTP_TO_ADDRESS=
# true 使用隐式 SSL(如 465 端口)，false 使用 STARTTLS(如 587 端口)
SMTP_USE_SSL=true


################################################################################
# 🛡️ 6. 高级功能 (可选)
################################################################################

# --- 任务失败保护 ---
# 当任务持续失败(如 Cookie 失效)时，自动暂停避免风控。
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
# 状态文件路径 (默认 logs/task-failure-guard.json)
TASK_FAILURE_GUARD_PATH=

# --- 任务运行日志清理 ---
# 启动时自动清理 logs/*.log 中超过保留天数的历史日志（默认 7 天）
TASK_LOG_RETENTION_DAYS=7
# 单个任务日志文件超过多少字节就在下次启动前轮转一份到 .1（默认 5MB）
TASK_LOG_MAX_BYTES=5242880

# --- 应用日志级别 ---
# DEBUG/INFO/WARNING/ERROR，默认 INFO
LOG_LEVEL=INFO

# --- 历史数据清理 ---
# 启动时自动清理超过保留天数的价格快照 / 历史商品结果记录，设为 0 表示不清理、永久保留
PRICE_SNAPSHOT_RETENTION_DAYS=30
RESULT_ITEM_RETENTION_DAYS=90

# --- 跨任务去重与 AI 成本控制 ---
# 同一商品在多少小时内已被(任意任务)推送过就不再重复推送，设为 0 关闭跨任务去重
CROSS_TASK_NOTIFICATION_DEDUP_HOURS=24
# 同一商品(内容+该任务的 prompt 相同)在多少小时内复用已有的 AI 分析结果，设为 0 关闭缓存
AI_RESULT_CACHE_TTL_HOURS=24
# 跨进程全局同时运行的 AI 请求数上限，默认 0 = 不限制；多任务并发跑且容易触发限流时可以调小
GLOBAL_AI_CONCURRENCY_LIMIT=0

# --- 代理池轮换 ---
PROXY_ROTATION_ENABLED=false
# per_task 或 on_failure
PROXY_ROTATION_MODE="per_task"
PROXY_POOL=""
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300
